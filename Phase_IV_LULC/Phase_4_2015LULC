/**
 * =============================================================================
 * PROJECT: Al Gash Basin - LULC 2015 Classification
 * AUTHOR: Asia Hamdi & Team (GSRIC)
 * ORGANIZATION: Geo-Science Research & Innovation Circle (GSRIC)
 * DESCRIPTION: Multi-spectral Random Forest LULC Classification & Metrics
 * =============================================================================
 */

// ── 1. SETUP & PARAMETERS ───────────────────────────────────────────────────
var roi = ee.FeatureCollection('projects/beaming-set-482612-c2/assets/Algash_basin_utm37');
var dissolvedROI = roi.geometry().dissolve().simplify(100);

Map.centerObject(roi, 10);
Map.setOptions('HYBRID');

var YEAR = 2015; 
var SCALE = 30;
var NDVI_CROPLAND_THRESHOLD = 0.38; 

var palette = ['#C8A96E', '#4DB6E8', '#F5C518', '#2D6A4F', '#C0392B'];
var names = [
  '[0] Highlands/Bareland', 
  '[1] Active River System', 
  '[2] Cropland', 
  '[3] Natural Vegetation', 
  '[4] Urban/Built-up'
];

// ── 2. DATA ACQUISITION & FEATURE STACKING ───────────────────────────────────
function maskL8SR(image) {
  var qaMask = image.select('QA_PIXEL').bitwiseAnd(1 << 3).eq(0)
                 .and(image.select('QA_PIXEL').bitwiseAnd(1 << 5).eq(0));
  return image.updateMask(qaMask);
}

var landsatCollection = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
  .filterBounds(dissolvedROI)
  .filterDate('2015-06-01', '2015-12-31')
  .filter(ee.Filter.lt('CLOUD_COVER', 20))
  .map(maskL8SR);

var landsatImage = landsatCollection.median().multiply(0.0000275).add(-0.2).clip(dissolvedROI);

// Spectral Indices
var ndvi = landsatImage.normalizedDifference(['SR_B5', 'SR_B4']).rename('NDVI');
var ndwi = landsatImage.normalizedDifference(['SR_B3', 'SR_B5']).rename('NDWI');
var mndwi = landsatImage.normalizedDifference(['SR_B3', 'SR_B6']).rename('MNDWI');
var ndbi = landsatImage.normalizedDifference(['SR_B6', 'SR_B5']).rename('NDBI');

var bsi = landsatImage.expression(
  '((SWIR1 + RED) - (NIR + BLUE)) / ((SWIR1 + RED) + (NIR + BLUE))', {
    'SWIR1': landsatImage.select('SR_B6'),
    'RED': landsatImage.select('SR_B4'),
    'NIR': landsatImage.select('SR_B5'),
    'BLUE': landsatImage.select('SR_B2')
}).rename('BSI');

var evi = landsatImage.expression(
  '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {
    'NIR': landsatImage.select('SR_B5'),
    'RED': landsatImage.select('SR_B4'),
    'BLUE': landsatImage.select('SR_B2')
}).rename('EVI');

// GLCM Texture Features
var nirInt = landsatImage.select('SR_B5').multiply(10000).toInt();
var glcm = nirInt.glcmTexture({size: 3});
var contrast = glcm.select('SR_B5_contrast').rename('NIR_Contrast');
var varB5 = glcm.select('SR_B5_var').rename('NIR_Variance');

// Feature Stack
var stack2015 = landsatImage.select(['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'])
  .addBands([ndvi, ndwi, mndwi, ndbi, bsi, evi, contrast, varB5]);

var featureNames = stack2015.bandNames();

// ── 3. SAMPLE PREPARATION & CLASSIFICATION ──────────────────────────────────
var c0 = Highlands_Bareland.map(function(f){ return f.set('LC', 0); });
var c1 = ActiveRiverSystem.map(function(f){ return f.set('LC', 1); });
var c2 = Cropland.map(function(f){ return f.set('LC', 2); });
var c3 = Natural_Vegetation.map(function(f){ return f.set('LC', 3); });
var c4 = Urban_Built_up.map(function(f){ return f.set('LC', 4); });

var allSamples = c0.merge(c1).merge(c2).merge(c3).merge(c4);

var sampledData = stack2015.sampleRegions({
  collection: allSamples,
  properties: ['LC'],
  scale: SCALE,
  tileScale: 16,
  geometries: false
});

var withRandom = sampledData.randomColumn('rand', 42);
var trainSet   = withRandom.filter(ee.Filter.lt('rand', 0.7));
var valSet     = withRandom.filter(ee.Filter.gte('rand', 0.7));

var classifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 500,
  minLeafPopulation: 1,
  bagFraction: 0.632,
  seed: 42
}).train({
  features: trainSet,
  classProperty: 'LC',
  inputProperties: featureNames
});

var classifiedImage = stack2015.classify(classifier).clip(dissolvedROI);

// Post-classification refinement using threshold control
var finalLULC = classifiedImage.where(classifiedImage.eq(2).and(ndvi.lt(NDVI_CROPLAND_THRESHOLD)), 3);

// ── 4. CONSOLE OUTPUTS & METRICS ─────────────────────────────────────────────
var valPredicted = valSet.classify(classifier);
var valAccuracy  = valPredicted.errorMatrix('LC', 'classification', [0,1,2,3,4]);

print('==================================================================');
print('         LULC CLASSIFICATION METRICS (' + YEAR + ')');
print('==================================================================');
print('1. CONFIGURATION:');
print('NDVI Cropland Threshold:', NDVI_CROPLAND_THRESHOLD);
print('2. ACCURACY RESULTS:');
print('Overall Accuracy:', valAccuracy.accuracy());
print('Kappa Coefficient:', valAccuracy.kappa());
print('Producer Accuracy:', valAccuracy.producersAccuracy());
print('User Accuracy:', valAccuracy.consumersAccuracy());
print('Confusion Matrix:', valAccuracy);

// Area Statistics
var areaStats = ee.Image.pixelArea().divide(10000).addBands(finalLULC).reduceRegion({
  reducer: ee.Reducer.sum().group({groupField: 1, groupName: 'class'}),
  geometry: dissolvedROI,
  scale: SCALE,
  maxPixels: 1e13,
  bestEffort: true
});

areaStats.evaluate(function(result) {
  if (result && result.groups) {
    print('------------------------------------------------------------------');
    print('3. SPATIAL AREA STATISTICS (Hectares):');
    var values = []; var labels = [];
    result.groups.forEach(function(item) {
      var areaHa = item.sum.toFixed(2);
      print(names[item.class] + ': ' + areaHa + ' Ha');
      values.push(parseFloat(areaHa));
      labels.push(names[item.class]);
    });

    print(ui.Chart.array.values({array: ee.Array(values), axis: 0, xLabels: labels})
      .setChartType('PieChart')
      .setOptions({title: 'LULC ' + YEAR + ' Area Distribution (Ha)', colors: palette, pieHole: 0.4}));
  }
});

// ── 5. MAP LAYERS & LEGEND ───────────────────────────────────────────────────
var mainLegend = ui.Panel({style: {position: 'bottom-left', padding: '8px 12px'}});
mainLegend.add(ui.Label('LULC Classes - ' + YEAR, {fontWeight: 'bold', fontSize: '13px', margin: '0 0 6px 0'}));
for (var i = 0; i < names.length; i++) {
  mainLegend.add(ui.Panel([
    ui.Label({style: {backgroundColor: palette[i], padding: '7px', margin: '0 6px 4px 0', border: '0.5px solid black'}}),
    ui.Label(names[i])
  ], ui.Panel.Layout.Flow('horizontal')));
}
Map.add(mainLegend);

Map.addLayer(landsatImage, {bands: ['SR_B6', 'SR_B5', 'SR_B4'], min: 0.0, max: 0.4}, '1. SWIR Composite');
Map.addLayer(finalLULC, {min: 0, max: 4, palette: palette}, '2. Final Refined LULC ' + YEAR);
Map.addLayer(roi, {color: 'white'}, 'AOI Boundary Profile', true, 0.4);

// ── 6. EXPORT TASK ───────────────────────────────────────────────────────────
Export.image.toDrive({
  image: finalLULC.uint8(),
  description: 'AlGash_LULC_' + YEAR,
  folder: 'GEE_Algash_Decadal_Project',
  region: dissolvedROI,
  scale: SCALE,
  crs: 'EPSG:32637',
  maxPixels: 1e13
});
