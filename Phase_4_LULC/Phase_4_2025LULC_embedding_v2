// ════════════════════════════════════════════════════════════════
// ALGASH BASIN — MULTI-YEAR LAND COVER CLASSIFICATION
// Google Satellite Embedding (AlphaEarth) V1 ANNUAL + Random Forest
// Classifies every year in YEARS with ONE classifier (trained on
// TRAIN_YEAR) and exports one GeoTIFF per year to Google Drive.
// ════════════════════════════════════════════════════════════════
 
// ── 1. STUDY AREA ─────────────────────────────────────────────────
var roi = ee.FeatureCollection('projects/beaming-set-482612-c2/assets/Algash_basin_utm37');
var dissolvedROI = roi.geometry().dissolve().simplify(100);
Map.centerObject(roi, 10);
Map.setOptions('HYBRID');
 
// ── 2. CONFIG ──────────────────────────────────────────────────────
var TRAIN_YEAR = 2023;                     // year used to build the training set
                                            // (pick the year your reference/field
                                            // imagery for the training polygons matches)
var YEARS = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024];
                                            // Satellite Embedding V1 ANNUAL currently
                                            // covers 2017–2024. If a newer year has been
                                            // released, add it here (the pre-flight check
                                            // below will warn you if a year has no data).
var SCALE        = 10;                     // metres
var CRS           = 'EPSG:32637';
var DRIVE_FOLDER  = 'GoogleEE';            // existing Drive folder
var CLASS_VALUES  = [0, 1, 2, 3, 4];
var LABELS   = ['Bareland', 'Active_River_System', 'Cropland', 'Natural_Vegetation', 'Urban_Built_up'];
var PALETTE  = ['#C8A96E', '#4DB6E8', '#F5C518', '#2D6A4F', '#C0392B'];
 
var EMBED_COLLECTION = 'GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL';
 
// ── helper: one year's mosaicked, clipped embedding image ─────────
function getEmbedding(year) {
  var col = ee.ImageCollection(EMBED_COLLECTION)
    .filterBounds(dissolvedROI)
    .filterDate(year + '-01-01', (year + 1) + '-01-01');
  return col.mosaic().clip(dissolvedROI);
}
 
// ── 3. PRE-FLIGHT: confirm each year actually has embedding data ──
print('══════════════════════════════════════');
print('PRE-FLIGHT: checking data availability per year');
YEARS.forEach(function(year) {
  var n = ee.ImageCollection(EMBED_COLLECTION)
    .filterBounds(dissolvedROI)
    .filterDate(year + '-01-01', (year + 1) + '-01-01')
    .size().getInfo();
  if (n === 0) {
    print('  ⚠ ' + year + ': NO embedding tiles found — this year will be skipped.');
  } else {
    print('  ✓ ' + year + ': ' + n + ' tile(s) found.');
  }
});
 
// ── 4. TRAIN THE CLASSIFIER (once, on TRAIN_YEAR) ──────────────────
var trainEmbedding = getEmbedding(TRAIN_YEAR);
var featureNames = trainEmbedding.bandNames();
print('══════════════════════════════════════');
print('Training-year (' + TRAIN_YEAR + ') embedding band count:', featureNames.size());
 
var allSamples = Highlands_Bareland.map(function(f){return f.set('LC', 0)})
  .merge(ActiveRiverSystem.map(function(f){return f.set('LC', 1)}))
  .merge(Cropland.map(function(f){return f.set('LC', 2)}))
  .merge(Natural_Vegetation.map(function(f){return f.set('LC', 3)}))
  .merge(Urban_Built_up.map(function(f){return f.set('LC', 4)}));
 
print('Total training polygons:', allSamples.size());
 
var sampledData = trainEmbedding.sampleRegions({
  collection: allSamples,
  properties: ['LC'],
  scale: SCALE,
  tileScale: 16,
  geometries: false
});
print('Total training pixels sampled:', sampledData.size());
 
var withRandom = sampledData.randomColumn('rand', 42);
var trainSet   = withRandom.filter(ee.Filter.lt('rand', 0.7));
var valSet     = withRandom.filter(ee.Filter.gte('rand', 0.7));
print('Train pixels:', trainSet.size());
print('Validation pixels:', valSet.size());
 
var rf = ee.Classifier.smileRandomForest({
  numberOfTrees: 200,
  variablesPerSplit: null,
  minLeafPopulation: 1,
  bagFraction: 0.632,
  seed: 42
}).train({
  features: trainSet,
  classProperty: 'LC',
  inputProperties: featureNames
});
 
// ── 5. ACCURACY ASSESSMENT (based on TRAIN_YEAR only) ──────────────
var trainMatrix = trainSet.classify(rf).errorMatrix('LC', 'classification', CLASS_VALUES);
var valMatrix   = valSet.classify(rf).errorMatrix('LC', 'classification', CLASS_VALUES);
 
print('══════════════════════════════════════');
print('TRAINING ACCURACY (' + TRAIN_YEAR + ')');
print('Confusion Matrix:', trainMatrix);
print('Overall Accuracy:', trainMatrix.accuracy());
print('Kappa Coefficient:', trainMatrix.kappa());
 
print('══════════════════════════════════════');
print('VALIDATION ACCURACY (' + TRAIN_YEAR + ', unseen data)');
print('Confusion Matrix:', valMatrix);
print('Overall Accuracy:', valMatrix.accuracy());
print('Kappa Coefficient:', valMatrix.kappa());
print('Producers Accuracy:', valMatrix.producersAccuracy());
print('Consumers Accuracy:', valMatrix.consumersAccuracy());
print('Feature Importance:', rf.explain());
 
// ── 6. LEGEND ────────────────────────────────────────────────────
var legend = ui.Panel({style: {position: 'bottom-left', padding: '8px 12px', backgroundColor: 'white'}});
legend.add(ui.Label({value: 'Land Cover — Algash Basin',
  style: {fontWeight: 'bold', fontSize: '13px', margin: '0 0 6px 0'}}));
var displayLabels = ['Bareland', 'Active River System', 'Cropland', 'Natural Vegetation', 'Urban / Built-up'];
PALETTE.forEach(function(col, i) {
  var row = ui.Panel({layout: ui.Panel.Layout.flow('horizontal'), style: {margin: '2px 0'}});
  row.add(ui.Label({style: {backgroundColor: col, padding: '7px', margin: '0 6px 0 0', border: '1px solid #aaa'}}));
  row.add(ui.Label(displayLabels[i]));
  legend.add(row);
});
Map.add(legend);
Map.addLayer(roi, {color: 'white'}, 'AOI Boundary', true, 0.6);
 
// ── 7. CLASSIFY EVERY YEAR, MAP, ACCUMULATE AREA STATS, EXPORT ────
var allAreaFeatures = ee.FeatureCollection([]);
 
YEARS.forEach(function(year) {
  var embedding = getEmbedding(year);
  var classified = embedding.classify(rf).clip(dissolvedROI).byte().rename('landcover');
 
  // show only the training year by default to keep the map responsive
  Map.addLayer(classified, {min: 0, max: 4, palette: PALETTE}, 'Land Cover ' + year, year === TRAIN_YEAR);
 
  // per-class area (km²), computed server-side in one reduceRegion call
  var areaDict = ee.Image.pixelArea().divide(1e6)
    .addBands(classified)
    .reduceRegion({
      reducer: ee.Reducer.sum().group({groupField: 1, groupName: 'LC'}),
      geometry: dissolvedROI,
      scale: SCALE,
      maxPixels: 1e13
    });
 
  var groups = ee.List(areaDict.get('groups'));
  var classNamesList = ee.List(LABELS);
  var yearAreaFC = ee.FeatureCollection(groups.map(function(g) {
    g = ee.Dictionary(g);
    var classId = ee.Number(g.get('LC'));
    return ee.Feature(null, {
      'year': year,
      'class_id': classId,
      'class_name': classNamesList.get(classId),
      'area_km2': g.get('sum')
    });
  }));
  allAreaFeatures = allAreaFeatures.merge(yearAreaFC);
 
  Export.image.toDrive({
    image: classified,
    description: 'LandCover_Algash_' + year,
    folder: DRIVE_FOLDER,
    fileNamePrefix: 'landcover_' + year,
    region: dissolvedROI,
    scale: SCALE,
    crs: CRS,
    maxPixels: 1e13
  });
});
 
print('══════════════════════════════════════');
print('Per-year, per-class area table (also exported as CSV):', allAreaFeatures);
 
// One combined CSV: year, class_id, class_name, area_km2 (long/tidy format —
// easy to pivot with pandas in VS Code for land-cover change & Active River
// System morphology analysis).
Export.table.toDrive({
  collection: allAreaFeatures,
  description: 'LandCover_Algash_AreaStats_AllYears',
  folder: DRIVE_FOLDER,
  fileNamePrefix: 'landcover_area_stats_allyears',
  fileFormat: 'CSV'
});
 
// ── 8. QUICK VISUAL CHECK: pie chart for the training year ────────
var trainYearStats = ee.Image.pixelArea().divide(1e6)
  .addBands(getEmbedding(TRAIN_YEAR).classify(rf).clip(dissolvedROI).byte())
  .reduceRegion({
    reducer: ee.Reducer.sum().group({groupField: 1, groupName: 'LC'}),
    geometry: dissolvedROI,
    scale: SCALE,
    maxPixels: 1e13
  });
 
trainYearStats.evaluate(function(result) {
  var values = [];
  var chartLabels = [];
  result.groups.forEach(function(item) {
    values.push(parseFloat(item.sum.toFixed(2)));
    chartLabels.push(displayLabels[item.class]);
  });
  var chart = ui.Chart.array.values({array: ee.Array(values), axis: 0, xLabels: chartLabels})
    .setChartType('PieChart')
    .setOptions({
      title: 'Land Cover Area Distribution (km²) — ' + TRAIN_YEAR,
      colors: PALETTE,
      pieHole: 0.4
    });
  print(chart);
});
 
